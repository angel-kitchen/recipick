# .env로 복사해 사용한다 (.env는 커밋하지 않는다)
# MYSQL_DATABASE·MYSQL_USER·MYSQL_PASSWORD는 application-local.yml의 datasource 값과 맞춘다
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=recipick
MYSQL_USER=recipick
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
REDIS_PORT=6379

# 무료체험 차단용 별도 Base64 키(최소 32바이트), 운영에서는 필수
TRIAL_BLOCK_HMAC_SECRET=

# 빌링키 저장 암호화 키(Base64, 디코딩 후 정확히 32바이트)와 지문 키(Base64, 32바이트 이상). 로컬은 비워 두면 ~/.recipick 아래 자동 생성
BILLING_KEY_ENCRYPTION_SECRET=
BILLING_KEY_HMAC_SECRET=
