# HTTP 단계(도메인·인증서 발급 전). HTTPS 전환 시 이 파일을 app.conf.disabled로 바꾸고 app-https.conf.disabled를 켠다.
# 이 단계는 인증서 발급과 첫 응답 확인을 위한 짧은 구간이다. 요청이 평문으로 오가므로 테스트 계정만 쓰고 실제 사용자·결제를 받지 않는다.
# 운영 리프레시 쿠키는 Secure라 이 단계에서는 토큰 재발급도 동작하지 않는다(README 5절)
server {
    listen 80 default_server;
    server_name _;

    # certbot webroot 검증 경로
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        include /etc/nginx/proxy_params;
        proxy_pass http://app;
    }
}
