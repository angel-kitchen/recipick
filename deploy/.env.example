# 운영 서버의 /opt/recipick/.env (권한 600)로 복사해 값을 채운다. 실제 값은 저장소·이미지·로그에 넣지 않는다.
# compose 파일 세 개가 이 파일을 읽어 치환한다. 앱 컨테이너에는 compose.yml이 고른 값만 넘어간다.

# --- 이미지 (compose.yml) ---
# ECR 저장소 URL. OIDC 설정 전 GHCR로 시작하면 ghcr.io/angel-kitchen/recipick
IMAGE=
# 커밋 SHA. 배포 스크립트가 덮어쓴다
IMAGE_TAG=

# --- 앱 (Spring 완화 바인딩: SPRING_DATASOURCE_URL → spring.datasource.url) ---
# &가 들어가는 값은 셸 스크립트에서도 읽히도록 큰따옴표로 감싼다(compose는 따옴표를 벗겨 읽는다)
SPRING_PROFILES_ACTIVE=prod
# MySQL. 서비스 이름은 compose.infra.yml의 mysql. RDS로 옮기면 URL만 바꾼다
SPRING_DATASOURCE_URL="jdbc:mysql://mysql:3306/recipick?serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
SPRING_DATASOURCE_USERNAME=recipick
SPRING_DATASOURCE_PASSWORD=
# Redis. 서비스 이름은 compose.infra.yml의 redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
# JWT 서명 키. Base64 문자열이어야 하고 디코딩 후 32바이트 이상이어야 기동한다. 생성: openssl rand -base64 48
JWT_SECRET=
# 무료체험 차단용 휴대전화 해시 키. JWT_SECRET과 다른 값으로, 같은 조건(Base64, 디코딩 후 32바이트 이상). 생성: openssl rand -base64 48
# 바꾸면 이미 저장된 차단 기록과 맞지 않으므로 처음 정한 값을 계속 쓴다
TRIAL_BLOCK_HMAC_SECRET=
# 프론트 Origin(쉼표 구분). 없으면 비워 둔다. 경로·와일드카드 없는 http(s) Origin만 허용된다
CORS_ALLOWED_ORIGINS=
# PortOne V2. PORTONE_API_SECRET이 비어 있으면 앱이 기동하지 않는다. 결제 검증 전까지는 임시 값으로 띄울 수 있다
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
# 웹훅 서명 검증 키(whsec_로 시작). 콘솔 > 결제 연동 > 웹훅에서 위 상점 ID와 같은 상점으로 발급한다. 비어 있으면 앱은 뜨고 웹훅만 거절한다
PORTONE_WEBHOOK_SECRET=
# AI. 비워 두면 가짜 응답(fake)으로 뜬다. claude로 바꾸면 ANTHROPIC_API_KEY가 비어 있을 때 앱이 기동하지 않는다
AI_CLIENT=fake
ANTHROPIC_API_KEY=

# --- MySQL 컨테이너 (compose.infra.yml). 위 SPRING_DATASOURCE_* 와 같은 DB·계정·비밀번호 ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=recipick
MYSQL_USER=recipick
MYSQL_PASSWORD=

# --- 배포 확인·백업 (scripts/deploy.sh, scripts/backup.sh) ---
# nginx를 거친 응답 확인 주소. 리다이렉트를 따라가 최종 200이어야 성공이다.
# 도메인 DNS를 연결하면 http://<도메인>/api/categories 로 바꾸고 이후 고치지 않는다. HTTPS 전환 뒤에는 301을 따라가
# 인증서와 HTTPS 블록까지 확인한다. 127.0.0.1로 두면 HTTPS 전환 뒤 https://127.0.0.1 로 가서 인증서 이름이 맞지 않아 실패한다
PROXY_CHECK_URL=http://127.0.0.1/api/categories
# nightly 백업을 올릴 S3 버킷(aws-setup.md 3절)
BACKUP_BUCKET=
# 백업 실패 알림. Discord·Slack 웹훅 주소. 비우면 알리지 않고 cron 로그에만 남는다
ALERT_WEBHOOK_URL=

# --- 모니터링 (compose.monitoring.yml, 나중에) ---
GRAFANA_ADMIN_PASSWORD=
