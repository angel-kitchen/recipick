# application-local.yml로 복사해 사용한다 (application-local.yml은 커밋하지 않는다)
# datasource 값은 .env의 MYSQL_DATABASE·MYSQL_USER·MYSQL_PASSWORD와 맞춘다
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/recipick?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: recipick
    password: change-me
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true
    show-sql: true
  data:
    redis:
      host: localhost
      port: 6379

# PortOne V2 API Secret은 관리자 콘솔 > 결제 연동 탭에서 발급한다. 실제 값은 커밋하지 않는다
portone:
  api-secret: change-me
  base-url: https://api.portone.io
  connect-timeout: 3s
  read-timeout: 5s
  store-id: ""
  channel-key: ""
