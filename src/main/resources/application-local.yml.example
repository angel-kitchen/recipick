# application-local.yml로 복사해 사용한다 (application-local.yml은 커밋하지 않는다)
# datasource 값은 .env의 MYSQL_DATABASE·MYSQL_USER·MYSQL_PASSWORD와 맞춘다
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/recipick?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: recipick
    password: change-me
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true
    show-sql: true
  data:
    redis:
      host: localhost
      port: 6379
