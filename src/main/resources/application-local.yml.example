# application-local.yml로 복사해 사용한다 (application-local.yml은 커밋하지 않는다)
# datasource 값은 .env의 MYSQL_DATABASE·MYSQL_USER·MYSQL_PASSWORD와 맞춘다
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/recipick?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: recipick
    password: change-me
    hikari:
      # 기존 MySQL을 재사용해도 앱 연결의 잠금 대기는 팀 기준 5초로 맞춘다.
      connection-init-sql: SET SESSION innodb_lock_wait_timeout = 5
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true
    show-sql: true
  data:
    redis:
      host: localhost
      port: 6379

# PortOne V2 API Secret은 관리자 콘솔 > 결제 연동 탭에서 발급한다. 실제 값은 커밋하지 않는다
portone:
  api-secret: change-me
  base-url: https://api.portone.io
  connect-timeout: 3s
  read-timeout: 5s
  store-id: ""
  channel-key: ""
  # 웹훅 시크릿은 관리자 콘솔 > 결제 연동 > 웹훅 탭에서 발급한다. 비어 있으면 앱은 뜨고 웹훅만 거절한다
  webhook:
    secret: ""

# 키가 있으면 client를 claude로 바꾸고 api-key를 넣는다. 실제 값은 커밋하지 않는다
ai:
  client: fake
  claude:
    api-key: ""
