# 이 파일을 application-local.yml로 복사해 본인 환경 값으로 채운다 (application-local.yml은 커밋하지 않는다)
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/recipick?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: change-me
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true
    show-sql: true
  data:
    redis:
      host: localhost
      port: 6379
